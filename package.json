{
  "name": "gsd-for-omp",
  "version": "1.1.1",
  "description": "Oh My Pi host plugin for the GSD Embeddable Orchestration System — extension bindings, slash-command surface, Host-Integration SDK adapter, and optional Goal Mode status integration for AI coding agents",
  "license": "MIT",
  "author": "Gilles Manzato",
  "contributors": [
    "tchivs (original gsd-omp author)"
  ],
  "type": "commonjs",
  "bin": {
    "gsd-for-omp": "bin/gsd-for-omp.cjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs"
  ],
  "scripts": {
    "lint": "node scripts/lint.cjs",
    "test": "node --test",
    "prepack": "npm run lint && npm test"
  },
  "dependencies": {
    "@opengsd/gsd-core": "^1.18.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "gsd": ">=1.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GManzato/gsd-for-omp.git"
  },
  "homepage": "https://github.com/GManzato/gsd-for-omp#readme",
  "bugs": {
    "url": "https://github.com/GManzato/gsd-for-omp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gsd",
    "omp",
    "oh-my-pi",
    "eos",
    "goal-mode",
    "host-plugin",
    "orchestration",
    "embeddable",
    "cli",
    "plugin",
    "agent-orchestration",
    "ai-agent",
    "llm",
    "coding-agent",
    "developer-tools",
    "automation"
  ]
}
